NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
SWAGGER_PATH=api/docs
CORS_ORIGINS=http://localhost:3000,http://10.0.2.2:3000
LOG_LEVEL=info

POSTGRES_USER=codebro
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=codebro
DATABASE_URL=postgresql://codebro:replace-with-db-password@localhost:5432/codebro?schema=public

REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

PRISMA_LOG=false
PRISMA_SKIP_CONNECT=false
SEED_DEMO_PASSWORD=replace-with-demo-password
